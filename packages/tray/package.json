{
  "name": "@gd-kirie/tray",
  "version": "0.14.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/gd-kirie/kirie-plugins.git",
    "directory": "packages/tray"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts"
    },
    "./plugin": {
      "import": "./src/plugin.ts"
    }
  },
  "files": [
    "addon",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test:run": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gd-kirie/ipc-eventa": "0.14.2",
    "@moeru/eventa": "catalog:"
  },
  "peerDependencies": {
    "kirie": "^0.14.2"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./plugin": {
        "types": "./dist/plugin.d.ts",
        "import": "./dist/plugin.js"
      }
    }
  }
}
