[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.7"

[libraries]
macos.arm64 = "./bin/aarch64-apple-darwin/libkirie_tray_native.dylib"
macos.x86_64 = "./bin/x86_64-apple-darwin/libkirie_tray_native.dylib"
linux.arm64 = "./bin/aarch64-unknown-linux-gnu/libkirie_tray_native.so"
linux.x86_64 = "./bin/x86_64-unknown-linux-gnu/libkirie_tray_native.so"
windows.arm64 = "./bin/aarch64-pc-windows-msvc/kirie_tray_native.dll"
windows.x86_64 = "./bin/x86_64-pc-windows-msvc/kirie_tray_native.dll"
