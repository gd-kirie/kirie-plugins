<Project Sdk="Godot.NET.Sdk/4.7.2">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- This library does not provide the application's Godot entry point. -->
    <GodotDisabledSourceGenerators>GodotPluginsInitializer</GodotDisabledSourceGenerators>
    <PackageId>GdKirie.Tray.EventaAdapter</PackageId>
    <Version>0.13.0</Version>
    <Authors>Moeru AI</Authors>
    <Description>Eventa adapter for Kirie native tray and menu objects.</Description>
    <PackageTags>godot;kirie;eventa;tray;menu</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/gd-kirie/kirie-plugins</PackageProjectUrl>
    <RepositoryUrl>https://github.com/gd-kirie/kirie-plugins</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../GdKirie.Tray/GdKirie.Tray.csproj" />
    <PackageReference Include="GdKirie.EventaAdapter" Version="0.13.0" ExcludeAssets="contentFiles" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
