<Project Sdk="Godot.NET.Sdk/4.7.2">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- This library does not provide the application's Godot entry point. -->
    <GodotDisabledSourceGenerators>GodotPluginsInitializer</GodotDisabledSourceGenerators>
    <PackageId>GdKirie.Tray</PackageId>
    <Version>0.13.0</Version>
    <Authors>Moeru AI</Authors>
    <Description>Native system tray and menu objects for Godot applications.</Description>
    <PackageTags>godot;kirie;tray;menu;status-item</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/gd-kirie/kirie-plugins</PackageProjectUrl>
    <RepositoryUrl>https://github.com/gd-kirie/kirie-plugins</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageOutputPath>bin/$(Configuration)</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="GdKirie.Tray.EventaAdapter" />
  </ItemGroup>

</Project>
